[Unit]
Description=botvpn telegram service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botvpn
WorkingDirectory=/opt/botvpn
EnvironmentFile=/opt/botvpn/.env
ExecStart=/opt/botvpn/.venv/bin/python /opt/botvpn/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
